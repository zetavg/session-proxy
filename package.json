{
  "name": "session-proxy",
  "version": "0.0.0",
  "type": "module",
  "description": "A local HTTP proxy that reuses browser session state for authenticated requests.",
  "bin": {
    "session-proxy": "./bin/session-proxy.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"No build step required\"",
    "pack-package": "mv \"$(npm pack)\" package.tgz",
    "publish-packed-package": "npm publish package.tgz --access public",
    "clean": "rm -rf package.tgz"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "keywords": [
    "proxy",
    "session",
    "browser",
    "automation",
    "playwright",
    "cookies"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "citty": "^0.2.0",
    "playwright": "^1.53.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@zetavg/eslint-config": "^0.0.5-pre.4",
    "@zetavg/prettier-config": "^0.0.4",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1"
  }
}
